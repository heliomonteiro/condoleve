# Copie este arquivo para .env e preencha com as credenciais públicas do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_KEY=sua_chave_publica_anon_ou_publishable

# Opcional: Link de checkout (Stripe, Asaas, Kiwify) ou WhatsApp comercial p/ ativação do Plano Pro
VITE_CHECKOUT_URL=
VITE_COMERCIAL_WHATSAPP=5534999358189

# Ative "true" após configurar o provedor Google (Gmail) em Authentication > Providers no Supabase
VITE_ENABLE_GOOGLE_AUTH=false

# Ative "true" após publicar asaas-checkout/asaas-webhook e configurar ASAAS_API_KEY no Supabase
VITE_ASAAS_ENABLED=false
